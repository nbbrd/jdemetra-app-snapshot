<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.nbbrd.jdemetra-app-snapshot</groupId>
    <artifactId>jdemetra-app-snapshot</artifactId>
    <version>1.0.0-snapshot</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2024-01-01T00:00:00Z</project.build.outputTimestamp>

        <java.bundled.version>25.0.5+1</java.bundled.version>
        <jdplus-main.version>3.9.1-SNAPSHOT</jdplus-main.version>
        <jdplus-benchmarking.version>2.2.1-SNAPSHOT</jdplus-benchmarking.version>
        <jdplus-incubator.version>2.5.3-SNAPSHOT</jdplus-incubator.version>
        <jdplus-eurostat.version>3.0.1-SNAPSHOT</jdplus-eurostat.version>
        <jdplus-ws.version>1.0.0-SNAPSHOT</jdplus-ws.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-main-desktop-bin</artifactId>
            <version>${jdplus-main.version}</version>
            <type>zip</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-main-cli-bin</artifactId>
            <version>${jdplus-main.version}</version>
            <type>zip</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-benchmarking-desktop-plugin</artifactId>
            <version>${jdplus-benchmarking.version}</version>
            <type>nbm</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-highfreq-desktop-plugin</artifactId>
            <version>${jdplus-incubator.version}</version>
            <type>nbm</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-stl-desktop-plugin</artifactId>
            <version>${jdplus-incubator.version}</version>
            <type>nbm</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-sts-desktop-plugin</artifactId>
            <version>${jdplus-incubator.version}</version>
            <type>nbm</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-jvsqr-desktop-plugin</artifactId>
            <version>${jdplus-eurostat.version}</version>
            <type>nbm</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sat</groupId>
            <artifactId>jdplus-ws</artifactId>
            <version>${jdplus-ws.version}</version>
            <type>jar</type>
            <classifier>runner</classifier>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.simplify4u.plugins</groupId>
                    <artifactId>pgpverify-maven-plugin</artifactId>
                    <version>1.19.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jreleaser</groupId>
                    <artifactId>jdks-maven-plugin</artifactId>
                    <version>1.27.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-xml</artifactId>
                            <version>4.2.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>io.github.floverfelt</groupId>
                    <artifactId>find-and-replace-maven-plugin</artifactId>
                    <version>1.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>com.github.nbbrd.nbbrd-maven-tools</groupId>
                    <artifactId>bundle-maven-plugin</artifactId>
                    <version>1.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 1. Check signatures and create timestamp -->
            <plugin>
                <groupId>org.simplify4u.plugins</groupId>
                <artifactId>pgpverify-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-signatures</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <verifySnapshots>true</verifySnapshots>
                            <failNoSignature>true</failNoSignature>
                            <failWeakSignature>true</failWeakSignature>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>setup-timestamp</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>timestamp-property</goal>
                        </goals>
                        <configuration>
                            <name>timestamp</name>
                            <pattern>yyyyMMddHHmmss</pattern>
                            <locale>ROOT</locale>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Gather plugins, binaries and JRE -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugins-and-binaries</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <useBaseVersion>true</useBaseVersion>
                            <outputDirectory>${project.build.directory}/upload</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jreleaser</groupId>
                <artifactId>jdks-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-jre</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>setup-disco</goal>
                        </goals>
                        <configuration>
                            <pkgs>
                                <pkg>
                                    <name>jdk-windows-x86_64</name>
                                    <distribution>zulu</distribution>
                                    <platform>windows-x86_64</platform>
                                    <version>${java.bundled.version}</version>
                                    <packageType>jre</packageType>
                                    <archiveType>zip</archiveType>
                                </pkg>
                                <pkg>
                                    <name>jdk-windows-aarch_64</name>
                                    <distribution>zulu</distribution>
                                    <platform>windows-aarch64</platform>
                                    <version>${java.bundled.version}</version>
                                    <packageType>jre</packageType>
                                    <archiveType>zip</archiveType>
                                </pkg>
                                <pkg>
                                    <name>jdk-linux-x86_64</name>
                                    <distribution>zulu</distribution>
                                    <platform>linux-x86_64</platform>
                                    <version>${java.bundled.version}</version>
                                    <packageType>jre</packageType>
                                    <archiveType>tar.gz</archiveType>
                                </pkg>
                                <pkg>
                                    <name>jdk-linux-aarch_64</name>
                                    <distribution>zulu</distribution>
                                    <platform>linux-aarch64</platform>
                                    <version>${java.bundled.version}</version>
                                    <packageType>jre</packageType>
                                    <archiveType>tar.gz</archiveType>
                                </pkg>
                                <pkg>
                                    <name>jdk-osx-x86_64</name>
                                    <distribution>zulu</distribution>
                                    <platform>osx-x86_64</platform>
                                    <version>${java.bundled.version}</version>
                                    <packageType>jre</packageType>
                                    <archiveType>tar.gz</archiveType>
                                </pkg>
                                <pkg>
                                    <name>jdk-osx-aarch_64</name>
                                    <distribution>zulu</distribution>
                                    <platform>osx-aarch64</platform>
                                    <version>${java.bundled.version}</version>
                                    <packageType>jre</packageType>
                                    <archiveType>tar.gz</archiveType>
                                </pkg>
                            </pkgs>
                            <unpack>false</unpack>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Create binaries bundled with JRE -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>rename-binaries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <move file="${project.build.directory}/upload/jdplus-main-cli-bin-${jdplus-main.version}.zip"
                                      tofile="${project.build.directory}/upload/jwsacruncher-${jdplus-main.version}.zip"/>
                                <move file="${project.build.directory}/upload/jdplus-main-desktop-bin-${jdplus-main.version}.zip"
                                      tofile="${project.build.directory}/upload/jdemetra-${jdplus-main.version}.zip"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.nbbrd.nbbrd-maven-tools</groupId>
                <artifactId>bundle-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pack-cli-binaries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>bundle-jdk</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.build.directory}/upload/jwsacruncher-${jdplus-main.version}.zip</inputFile>
                            <applicationRoot>jwsacruncher-${jdplus-main.version}</applicationRoot>
                            <launcherId>appassembler</launcherId>
                            <appName>jwsacruncher</appName>
                            <archivePathTemplate>${project.build.directory}/jdks/jdk-{id}</archivePathTemplate>
                            <outputFileTemplate>${project.build.directory}/upload/jwsacruncher-standalone-${jdplus-main.version}-{id}.zip</outputFileTemplate>
                            <runtimeIds>windows-x86_64,windows-aarch_64,linux-x86_64,linux-aarch_64,osx-x86_64,osx-aarch_64</runtimeIds>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pack-desktop-binaries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>bundle-jdk</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.build.directory}/upload/jdemetra-${jdplus-main.version}.zip</inputFile>
                            <applicationRoot>nbdemetra</applicationRoot>
                            <launcherId>netbeans</launcherId>
                            <appName>nbdemetra</appName>
                            <archivePathTemplate>${project.build.directory}/jdks/jdk-{id}</archivePathTemplate>
                            <outputFileTemplate>${project.build.directory}/upload/jdemetra-standalone-${jdplus-main.version}-{id}.zip</outputFileTemplate>
                            <runtimeIds>windows-x86_64,windows-aarch_64,linux-x86_64,linux-aarch_64,osx-x86_64,osx-aarch_64</runtimeIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.floverfelt</groupId>
                <artifactId>find-and-replace-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-timestamp-to-filenames</id>
                        <phase>package</phase>
                        <goals>
                            <goal>find-and-replace</goal>
                        </goals>
                        <configuration>
                            <replacementType>filenames</replacementType>
                            <baseDir>target/upload/</baseDir>
                            <findRegex>-SNAPSHOT</findRegex>
                            <replaceValue>-SNAPSHOT+${timestamp}</replaceValue>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>jdemetra-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>nbbrd-snapshots</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
